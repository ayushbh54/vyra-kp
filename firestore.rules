rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Child device telemetry and status
    match /devices/{childId} {
      allow read, write: if true;
      
      match /commands/{commandId} {
        allow read, write: if true;
      }
    }
    
    // Call recordings and anti-tamper events
    match /calls/{childId}/records/{callId} {
      allow read, write: if true;
    }
    
    // Social and SMS chat messages (including deleted WhatsApp chats)
    match /chats/{childId}/messages/{msgId} {
      allow read, write: if true;
    }
    
    // Realtime notifications feed
    match /notifications/{childId}/items/{itemId} {
      allow read, write: if true;
    }
    
    // Watchlist high-risk target contacts
    match /watchlists/{childId}/targets/{targetId} {
      allow read, write: if true;
    }
  }
}
