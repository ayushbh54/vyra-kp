<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <!-- Top Bar with Hidden Settings Lock Icon -->
    <TextView
        android:id="@+id/tvDecoyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="System Toolkit"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivParentUnlock"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="Network Status"
        android:padding="4dp"
        android:src="@android:drawable/ic_popup_sync"
        android:tint="@color/text_secondary" />

    <!-- Center Content: Boring / Natural Decoy View -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivDecoyIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_sim_card" />

        <TextView
            android:id="@+id/tvDecoyHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SIM Services Active"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDecoyDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="SIM Services are active and up to date.\nNetwork carrier profiles verified."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDecoyStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_input_bg"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Status: Operational (OK)"
            android:textColor="@color/status_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:text="System Utility Services"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</RelativeLayout>
