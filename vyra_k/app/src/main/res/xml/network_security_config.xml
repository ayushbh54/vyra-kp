<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for Vyra Child App (vyra_k)
  Android 9+ (Pie) blocks all HTTP cleartext traffic by default.
  This config explicitly allows HTTP for:
    1. LAN/private IP ranges (192.168.x.x, 10.x.x.x, 172.16-31.x.x)
    2. localhost (for internal testing)
  All other traffic remains HTTPS-only (Supabase, Firebase = always HTTPS).
-->
<network-security-config>

    <!-- Allow cleartext HTTP only for local Wi-Fi LAN ranges -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Standard home/office Wi-Fi subnet -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.2.0</domain>
        <domain includeSubdomains="true">192.168.10.0</domain>
        <domain includeSubdomains="true">192.168.100.0</domain>
        <!-- Enterprise / corporate LAN -->
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">10.0.1.0</domain>
        <domain includeSubdomains="true">10.1.0.0</domain>
        <!-- Hotspot / mobile tethering range -->
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">172.20.0.0</domain>
        <!-- Localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>

    <!-- All other domains: HTTPS only (default secure baseline) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
