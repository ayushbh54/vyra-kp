<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — Vyra Child App (vyra_k)

  IMPORTANT: Android's <domain-config> uses hostname matching, NOT IP-range matching.
  Using <domain>192.168.1.0</domain> would only match that exact "hostname" string,
  NOT arbitrary IPs like 192.168.1.47. So we use <base-config> to allow cleartext
  for ALL traffic — which is safe here because:
    - All cloud calls (Supabase, Firebase) ALWAYS use HTTPS (https://)
    - Only intra-LAN HTTP calls go to port 8899 on the parent phone's IP
  This is the only correct Android approach for dynamic LAN IPs.
-->
<network-security-config>

    <!--
      Allow cleartext HTTP globally.
      All Supabase/Firebase URLs already use https:// so they are unaffected.
      LAN streaming (camera-frame, live-audio) uses http:// to child's dynamic IP.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
