<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — Vyra Parent App (vyra_p)

  IMPORTANT: Android's <domain-config> uses hostname matching, NOT IP-range matching.
  A <domain>192.168.1.0</domain> matches only that literal string, not 192.168.1.47.
  We use <base-config cleartextTrafficPermitted="true"> which is the ONLY correct
  Android approach for connecting to a child device at an unknown dynamic LAN IP.

  Safety: All Supabase calls use https:// — unaffected by this config.
  Only the LAN camera-frame + live-audio calls use http:// to port 8899.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
